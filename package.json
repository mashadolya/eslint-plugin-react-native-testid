{
  "name": "eslint-plugin-react-native-testid",
  "version": "0.1.0",
  "description": "ESLint rules that keep React Native testIDs present, consistent and unique, so Appium, Detox and Maestro tests stay stable",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react-native",
    "react native",
    "testID",
    "testid",
    "require-testid",
    "testid-missing",
    "accessibilityIdentifier",
    "mobile testing",
    "flaky tests",
    "ai coding agents",
    "test automation",
    "appium",
    "detox",
    "maestro",
    "e2e",
    "eslint9",
    "eslint10",
    "flat-config"
  ],
  "author": "Maryia Dolia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashadolya/eslint-plugin-react-native-testid.git"
  },
  "bugs": {
    "url": "https://github.com/mashadolya/eslint-plugin-react-native-testid/issues"
  },
  "homepage": "https://github.com/mashadolya/eslint-plugin-react-native-testid#readme",
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
